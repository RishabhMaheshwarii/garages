        {
          "name": "Nearby - 10 km, nearest 2",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/garages/nearby?lat={{lat}}&lng={{lng}}&radiusKm=10&limit=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "garages",
                "nearby"
