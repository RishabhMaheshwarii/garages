{
  "info": {
    "name": "Garage Services API",
    "description": "Garage + service catalogue with lat/lng nearby search (Delhi data).\n\nEdit collection variables baseUrl, lat, lng. Start the server with `npm run dev`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "lat",
      "value": "28.6129"
    },
    {
      "key": "lng",
      "value": "77.2295"
    },
    {
      "key": "garageId",
      "value": "1"
    },
    {
      "key": "serviceId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Nearby search (lat/lng)",
      "description": "GET /api/garages/nearby: nearest garages within radius, sorted by distance, with all services and durationMinutes.",
      "item": [
        {
          "name": "Nearby - 3 km",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/garages/nearby?lat={{lat}}&lng={{lng}}&radiusKm=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "garages",
                "nearby"
              ],
              "query": [
                {
                  "key": "lat",
                  "value": "{{lat}}",
                  "description": "User latitude (-90..90)"
                },
                {
                  "key": "lng",
                  "value": "{{lng}}",
                  "description": "User longitude (-180..180)"
                },
                {
                  "key": "radiusKm",
                  "value": "3"
                }
              ]
            }
          }
        },
        {
          "name": "Nearby - 5 km",
          "request": {
