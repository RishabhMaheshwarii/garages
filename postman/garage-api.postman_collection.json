                },
                {
                  "key": "service",
                  "value": "Car Wash",
                  "description": "Service name, case-insensitive"
                }
              ]
            }
          }
        },
        {
          "name": "Nearby - 10 km, by serviceId",
          "request": {
            "method": "GET",
