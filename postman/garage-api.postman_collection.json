            "body": {
              "mode": "raw",
              "raw": "{\n  \"durationMinutes\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "durationMinutes 1..54 (under 55 min)."
          }
        },
