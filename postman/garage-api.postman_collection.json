                  "description": "User longitude (-180..180)"
                },
                {
                  "key": "radiusKm",
                  "value": "10"
                },
                {
                  "key": "limit",
                  "value": "2",
                  "description": "1..100, default 20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Garages",
      "item": [
        {
          "name": "List garages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/garages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "garages"
              ]
            }
          }
        },
        {
          "name": "List garages incl. inactive",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/garages?includeInactive=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "garages"
              ],
              "query": [
                {
                  "key": "includeInactive",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Get garage",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/garages/{{garageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "garages",
                "{{garageId}}"
              ]
            }
          }
        },
        {
          "name": "Create garage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/garages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "garages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"delhi 11\",\n  \"address\": \"Hauz Khas, New Delhi\",\n  \"phone\": \"+91 98100 00000\",\n  \"lat\": 28.5494,\n  \"lng\": 77.2001,\n  \"services\": [\n    {\n      \"serviceId\": 1,\n      \"durationMinutes\": 30\n    },\n    {\n      \"serviceId\": 10,\n      \"durationMinutes\": 25\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "name, lat, lng required. services[].durationMinutes must be 1..54."
          }
        },
        {
          "name": "Update garage",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/garages/{{garageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "garages",
                "{{garageId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+91 98100 11111\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Send only fields to change. If `services` is included it REPLACES the garage's whole service list."
          }
        },
        {
          "name": "Delete garage",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/garages/{{garageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "garages",
                "{{garageId}}"
              ]
            }
          }
        }
      ]
    },
    {
