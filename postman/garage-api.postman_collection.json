              "raw": "{{baseUrl}}/api/garages/nearby?lat={{lat}}&lng={{lng}}&radiusKm=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "garages",
                "nearby"
              ],
              "query": [
                {
                  "key": "lat",
